rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection diagnostic read
    match /test/connection {
      allow get: if true;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'taqwagadgetzone@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validators
    function isValidSiteConfig(data, configId) {
      return data.keys().hasAll([
        'siteName', 'currencySymbol', 'announcement', 'navigation',
        'footer', 'seo', 'contact', 'theme', 'homepageSections', 'status', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'siteName', 'tagline', 'logoUrl', 'faviconUrl', 'currencySymbol',
        'defaultLanguage', 'deliveryZones', 'announcement', 'navigation', 'footer',
        'seo', 'contact', 'theme', 'homepageSections', 'status', 'updatedAt'
      ])
      && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 160
      && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 240))
      && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 800000))
      && (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 800000))
      && data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8
      && (!('defaultLanguage' in data) || data.defaultLanguage in ['bn', 'en'])
      && (!('deliveryZones' in data) || (data.deliveryZones is list && data.deliveryZones.size() <= 12))
      && data.announcement is map
      && data.navigation is list && data.navigation.size() <= 20
      && data.footer is map
      && data.seo is map
      && data.contact is map
      && data.theme is map
      && data.homepageSections is list && data.homepageSections.size() <= 40
      && data.status in ['published', 'draft']
      && data.status == configId
      && data.updatedAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
        'name', 'modelNumber', 'slug', 'category', 'regularPrice',
        'images', 'shortDescription', 'stock', 'descriptionBlocks',
        'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'name', 'modelNumber', 'slug', 'category', 'regularPrice', 'discountPrice',
        'images', 'videoUrl', 'shortDescription', 'fullDescription',
        'specifications', 'features', 'warranty', 'deliveryInfo', 'stock',
        'colors', 'variations', 'seoTitle', 'seoDescription', 'badges',
        'relatedProductIds', 'descriptionBlocks', 'draftPayload', 'status',
        'isFeatured', 'isBestSeller', 'isNewArrival', 'viewsCount', 'createdAt', 'updatedAt'
      ])
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
      && data.modelNumber is string && data.modelNumber.size() >= 1 && data.modelNumber.size() <= 80
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 180 && data.slug.matches('^[a-z0-9-]+$')
      && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
      && data.regularPrice is number && data.regularPrice >= 0
      && (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0))
      && data.images is list && data.images.size() <= 15
      && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500))
      && data.shortDescription is string && data.shortDescription.size() <= 600
      && (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 6000))
      && (!('specifications' in data) || (data.specifications is list && data.specifications.size() <= 60))
      && (!('features' in data) || (data.features is list && data.features.size() <= 30))
      && (!('warranty' in data) || (data.warranty is string && data.warranty.size() <= 500))
      && (!('deliveryInfo' in data) || (data.deliveryInfo is string && data.deliveryInfo.size() <= 500))
      && data.stock is number && data.stock >= 0
      && (!('colors' in data) || (data.colors is list && data.colors.size() <= 20))
      && (!('variations' in data) || (data.variations is list && data.variations.size() <= 20))
      && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 180))
      && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
      && (!('badges' in data) || (data.badges is list && data.badges.size() <= 10))
      && (!('relatedProductIds' in data) || (data.relatedProductIds is list && data.relatedProductIds.size() <= 12))
      && data.descriptionBlocks is list && data.descriptionBlocks.size() <= 40
      && (!('draftPayload' in data) || data.draftPayload == null || data.draftPayload is map)
      && data.status in ['published', 'draft']
      && (!('isFeatured' in data) || data.isFeatured is bool)
      && (!('isBestSeller' in data) || data.isBestSeller is bool)
      && (!('isNewArrival' in data) || data.isNewArrival is bool)
      && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0));
    }

    function isValidProductSecret(data, productId) {
      return data.keys().hasAll(['productId', 'purchasePrice', 'updatedAt'])
      && data.keys().hasOnly(['productId', 'purchasePrice', 'updatedAt'])
      && data.productId is string && data.productId == productId
      && data.purchasePrice is number && data.purchasePrice >= 0
      && data.updatedAt == request.time;
    }

    function isValidPage(data) {
      return data.keys().hasAll(['title', 'slug', 'blocks', 'status', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly([
        'title', 'slug', 'seoTitle', 'seoDescription', 'blocks',
        'draftPayload', 'isSystemPage', 'status', 'createdAt', 'updatedAt'
      ])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9-]+$')
      && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 180))
      && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 400))
      && data.blocks is list && data.blocks.size() <= 40
      && (!('draftPayload' in data) || data.draftPayload == null || data.draftPayload is map)
      && (!('isSystemPage' in data) || data.isSystemPage is bool)
      && data.status in ['published', 'draft'];
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'blocks', 'isPublic', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['name', 'category', 'description', 'blocks', 'isBuiltIn', 'isPublic', 'createdAt', 'updatedAt'])
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
      && (!('category' in data) || (data.category is string && data.category.size() <= 80))
      && (!('description' in data) || (data.description is string && data.description.size() <= 400))
      && data.blocks is list && data.blocks.size() <= 40
      && (!('isBuiltIn' in data) || data.isBuiltIn is bool)
      && data.isPublic is bool;
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['title', 'url', 'folder', 'isPublic', 'createdAt'])
      && data.keys().hasOnly(['title', 'url', 'folder', 'altText', 'isPublic', 'createdAt'])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && data.url is string && data.url.size() >= 1 && data.url.size() <= 800000
      && data.folder is string && data.folder.size() >= 1 && data.folder.size() <= 60
      && (!('altText' in data) || (data.altText is string && data.altText.size() <= 200))
      && data.isPublic is bool;
    }

    function isValidRevision(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'label', 'action', 'snapshot', 'authorEmail', 'createdAt'])
      && data.keys().hasOnly(['entityType', 'entityId', 'label', 'action', 'snapshot', 'authorEmail', 'createdAt'])
      && data.entityType in ['siteConfig', 'product', 'page', 'template']
      && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
      && data.label is string && data.label.size() >= 1 && data.label.size() <= 200
      && data.action in ['save_draft', 'publish', 'restore']
      && data.snapshot is map
      && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 180
      && data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderNumber', 'customerName', 'customerPhone', 'shippingAddress',
        'paymentMethod', 'items', 'totalAmount', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'orderNumber', 'customerUid', 'customerName', 'customerPhone', 'customerEmail',
        'shippingAddress', 'notes', 'deliveryZone', 'deliveryFee', 'subtotal',
        'paymentMethod', 'items', 'totalAmount', 'status', 'createdAt', 'updatedAt'
      ])
      && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
      && (!('customerUid' in data) || data.customerUid == null || (data.customerUid is string && data.customerUid.size() <= 128))
      && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
      && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 40
      && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 160))
      && data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 400
      && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
      && (!('deliveryZone' in data) || (data.deliveryZone is string && data.deliveryZone.size() <= 120))
      && (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0))
      && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0))
      && data.paymentMethod in ['cod', 'online']
      && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
      && data.totalAmount is number && data.totalAmount >= 0
      && data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled', 'returned'];
    }

    function isValidIncompleteOrder(data) {
      return data.keys().hasAll(['customerPhone', 'productName', 'updatedAt'])
      && data.keys().hasOnly(['customerName', 'customerPhone', 'shippingAddress', 'productName', 'totalAmount', 'updatedAt'])
      && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
      && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 40
      && (!('shippingAddress' in data) || (data.shippingAddress is string && data.shippingAddress.size() <= 400))
      && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 180
      && (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0))
      && data.updatedAt == request.time;
    }

    function isValidAdminDoc(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'permissions', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'email', 'role', 'permissions', 'createdAt', 'updatedAt'])
      && data.uid is string && data.uid == adminUid
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
      && data.role in ['super_admin', 'editor', 'catalog_manager']
      && data.permissions is list && data.permissions.size() <= 20;
    }

    // Collection Rules
    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && (configId == 'published' || (configId == 'draft' && isAdmin()));
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(configId) && (configId == 'published' || configId == 'draft') && isValidSiteConfig(incoming(), configId);
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isBootstrapAdmin();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /productSecrets/{productId} {
      allow get: if isValidId(productId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create, update: if isAdmin() && isValidId(productId) && isValidProductSecret(incoming(), productId);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /pages/{pageId} {
      allow get: if isValidId(pageId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isBootstrapAdmin();
      allow create: if isAdmin() && isValidId(pageId) && isValidPage(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(pageId) && isValidPage(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(pageId);
    }

    match /descriptionTemplates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if resource.data.isPublic == true || isBootstrapAdmin();
      allow create: if isAdmin() && isValidId(templateId) && isValidTemplate(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(templateId) && isValidTemplate(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(templateId);
    }

    match /mediaLibrary/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if resource.data.isPublic == true || isBootstrapAdmin();
      allow create: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    match /revisions/{revisionId} {
      allow get: if isValidId(revisionId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create: if isAdmin() && isValidId(revisionId) && isValidRevision(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(revisionId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerUid == request.auth.uid));
      allow list: if isBootstrapAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().status == 'pending'
        && (!('customerUid' in incoming()) || incoming().customerUid == null || (isSignedIn() && incoming().customerUid == request.auth.uid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /incompleteOrders/{leadId} {
      allow get: if isValidId(leadId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create, update: if isValidId(leadId) && isValidIncompleteOrder(incoming());
      allow delete: if isAdmin() && isValidId(leadId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isSignedIn() && request.auth.uid == adminUid));
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() && isValidId(adminUid) && isValidAdminDoc(incoming(), adminUid) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isBootstrapAdmin() && isValidId(adminUid) && isValidAdminDoc(incoming(), adminUid) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isBootstrapAdmin() && isValidId(adminUid);
    }
  }
}
